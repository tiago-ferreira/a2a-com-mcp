# Segurança, Segredos e Dados Pessoais / Credenciais
# ==============================================================================
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.secret
secrets/
credentials.json
client_secret*.json
REQUEST_STATE_SECRET*

# Logs e arquivos temporários de execução
*.log
logs/
*.tmp
tmp/
*.pid

# ==============================================================================
